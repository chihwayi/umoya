{
  "name": "mobile-app",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:e2e": "node ./scripts/e2e-smoke.mjs",
    "doctor": "npx expo-doctor",
    "release:check": "node ./scripts/release-version-check.mjs",
    "beta:check": "node ./scripts/beta-rollout-check.mjs",
    "beta:check:strict": "node ./scripts/beta-rollout-check.mjs --strict",
    "build:manifest:android:preview": "node ./scripts/generate-build-manifest.mjs --platform=android --profile=preview",
    "build:manifest:ios:preview": "node ./scripts/generate-build-manifest.mjs --platform=ios --profile=preview",
    "build:android:preview": "npx -y eas-cli build --platform android --profile preview",
    "build:ios:preview": "npx -y eas-cli build --platform ios --profile preview",
    "build:android:preview:ci": "npx -y eas-cli build --platform android --profile preview --non-interactive --no-wait",
    "build:ios:preview:ci": "npx -y eas-cli build --platform ios --profile preview --non-interactive --no-wait"
  },
  "dependencies": {
    "@sentry/react-native": "~7.11.0",
    "@tanstack/react-query": "^5.90.2",
    "axios": "^1.12.2",
    "expo": "~55.0.6",
    "expo-av": "16.0.8",
    "expo-camera": "55.0.9",
    "expo-constants": "55.0.7",
    "expo-document-picker": "55.0.8",
    "expo-file-system": "55.0.10",
    "expo-linking": "55.0.7",
    "expo-local-authentication": "^55.0.8",
    "expo-network": "~55.0.8",
    "expo-notifications": "55.0.12",
    "expo-router": "55.0.5",
    "expo-screen-capture": "^55.0.8",
    "expo-secure-store": "55.0.8",
    "expo-updates": "^55.0.13",
    "react": "19.2.0",
    "react-hook-form": "^7.62.0",
    "react-native": "0.83.2",
    "react-native-mmkv": "^3.3.0",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "4.23.0",
    "zod": "^4.1.11",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "@types/react-test-renderer": "^19.1.0",
    "babel-preset-expo": "~55.0.5",
    "eslint": "^9.39.4",
    "eslint-config-expo": "55.0.0",
    "jest": "~29.7.0",
    "jest-expo": "55.0.9",
    "react-test-renderer": "19.2.0",
    "typescript": "^5.9.3"
  },
  "expo": {
    "autolinking": {
      "searchPaths": [
        "./node_modules"
      ],
      "exclude": [
        "react"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "expo-av"
        ]
      }
    }
  }
}
