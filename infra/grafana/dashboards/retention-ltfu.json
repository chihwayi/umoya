{
  "title": "Retention & LTFU",
  "uid": "nc-retention-001",
  "tags": ["retention", "ltfu", "newlands"],
  "refresh": "5m",
  "schemaVersion": 38,
  "panels": [
    {
      "id": 1,
      "title": "Current LTFU Rate (%)",
      "type": "stat",
      "datasource": "PostgreSQL-MediCore",
      "targets": [{
        "rawSql": "SELECT (ltfu_count::float / NULLIF(active_count,0) * 100)::numeric(5,1) AS ltfu_rate FROM retention_snapshots ORDER BY computed_at DESC LIMIT 1",
        "format": "table"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": 0},
              {"color": "yellow", "value": 10},
              {"color": "red", "value": 20}
            ]
          }
        }
      },
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 6}
    },
    {
      "id": 2,
      "title": "Reengagement Count (30 days)",
      "type": "stat",
      "datasource": "PostgreSQL-MediCore",
      "targets": [{
        "rawSql": "SELECT COUNT(*) AS reengaged FROM ltfu_reengagement_log WHERE reengaged_at > NOW() - INTERVAL '30 days'",
        "format": "table"
      }],
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 6}
    },
    {
      "id": 3,
      "title": "6-Month Retention (%)",
      "type": "stat",
      "datasource": "PostgreSQL-MediCore",
      "targets": [{
        "rawSql": "SELECT retention_6m FROM retention_snapshots ORDER BY computed_at DESC LIMIT 1",
        "format": "table"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": 0},
              {"color": "yellow", "value": 80},
              {"color": "green", "value": 90}
            ]
          }
        }
      },
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 6}
    },
    {
      "id": 4,
      "title": "12-Month Retention (%)",
      "type": "stat",
      "datasource": "PostgreSQL-MediCore",
      "targets": [{
        "rawSql": "SELECT retention_12m FROM retention_snapshots ORDER BY computed_at DESC LIMIT 1",
        "format": "table"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": 0},
              {"color": "yellow", "value": 75},
              {"color": "green", "value": 85}
            ]
          }
        }
      },
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 6}
    },
    {
      "id": 5,
      "title": "LTFU Trend (6 months)",
      "type": "timeseries",
      "datasource": "PostgreSQL-MediCore",
      "targets": [{
        "rawSql": "SELECT computed_at AS time, (ltfu_count::float / NULLIF(active_count,0) * 100)::numeric(5,1) AS ltfu_rate FROM retention_snapshots WHERE computed_at > NOW() - INTERVAL '6 months' ORDER BY computed_at",
        "format": "table",
        "timeColumns": ["time"]
      }],
      "fieldConfig": {"defaults": {"unit": "percent"}},
      "gridPos": {"x": 0, "y": 6, "w": 24, "h": 10}
    }
  ]
}
