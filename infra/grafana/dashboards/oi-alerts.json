{
  "title": "OI Alert Operations",
  "uid": "nc-oi-alerts-001",
  "tags": ["oi", "alerts", "hiv", "newlands"],
  "refresh": "2m",
  "schemaVersion": 38,
  "panels": [
    {
      "id": 1,
      "title": "Open OI Alerts (Unacknowledged)",
      "type": "stat",
      "datasource": "PostgreSQL-Umoya",
      "targets": [{
        "rawSql": "SELECT COUNT(*) AS open_alerts FROM hiv_oi_alerts WHERE status = 'open' AND acknowledged_at IS NULL",
        "format": "table"
      }],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": 0},
              {"color": "yellow", "value": 5},
              {"color": "red", "value": 15}
            ]
          }
        }
      },
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 6}
    },
    {
      "id": 2,
      "title": "Acknowledged Today",
      "type": "stat",
      "datasource": "PostgreSQL-Umoya",
      "targets": [{
        "rawSql": "SELECT COUNT(*) AS acknowledged FROM hiv_oi_alerts WHERE acknowledged_at >= CURRENT_DATE",
        "format": "table"
      }],
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 6}
    },
    {
      "id": 3,
      "title": "Critical OI Alerts",
      "type": "stat",
      "datasource": "PostgreSQL-Umoya",
      "targets": [{
        "rawSql": "SELECT COUNT(*) AS critical FROM hiv_oi_alerts WHERE severity = 'critical' AND status = 'open'",
        "format": "table"
      }],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": 0},
              {"color": "red", "value": 1}
            ]
          }
        }
      },
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 6}
    },
    {
      "id": 4,
      "title": "OI Alerts by Type",
      "type": "piechart",
      "datasource": "PostgreSQL-Umoya",
      "targets": [{
        "rawSql": "SELECT oi_type, COUNT(*) AS count FROM hiv_oi_alerts WHERE status = 'open' GROUP BY oi_type ORDER BY count DESC",
        "format": "table"
      }],
      "gridPos": {"x": 0, "y": 6, "w": 12, "h": 10}
    },
    {
      "id": 5,
      "title": "OI Alert Trend (30 days)",
      "type": "timeseries",
      "datasource": "PostgreSQL-Umoya",
      "targets": [{
        "rawSql": "SELECT DATE_TRUNC('day', created_at) AS time, COUNT(*) AS alerts FROM hiv_oi_alerts WHERE created_at > NOW() - INTERVAL '30 days' GROUP BY 1 ORDER BY 1",
        "format": "table",
        "timeColumns": ["time"]
      }],
      "gridPos": {"x": 12, "y": 6, "w": 12, "h": 10}
    }
  ]
}
