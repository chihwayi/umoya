SERVER_HOST=localhost

PORT=3001
DATABASE_URL=postgresql://medicore:medicore_password@${SERVER_HOST}:5432/medicore_master
JWT_SECRET=medicore-super-secret-key

# CORS Configuration
CORS_ORIGINS=http://${SERVER_HOST}:3000,http://${SERVER_HOST}:3011,http://127.0.0.1:3000,http://127.0.0.1:3011

# AWS/MinIO Config for BackupService
BACKUP_BUCKET_NAME=medicore-backups
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_ENDPOINT=http://${SERVER_HOST}:9000

# Docker config for BackupService
DOCKER_PG_CONTAINER=medicore-postgres-master
DB_HOST=${SERVER_HOST}
DB_PORT=5432
DB_USERNAME=medicore
DB_PASSWORD=medicore_password
DB_DATABASE=medicore_master
