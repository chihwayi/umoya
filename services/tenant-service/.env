SERVER_HOST=localhost

PORT=3001
DATABASE_URL=postgresql://umoya:umoya_password@${SERVER_HOST}:5432/umoya_master
JWT_SECRET=umoya-super-secret-key

# CORS Configuration
CORS_ORIGINS=http://${SERVER_HOST}:3000,http://${SERVER_HOST}:3011,http://127.0.0.1:3000,http://127.0.0.1:3011

# AWS/MinIO Config for BackupService
BACKUP_BUCKET_NAME=umoya-backups
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_ENDPOINT=http://${SERVER_HOST}:9000

# Docker config for BackupService
DOCKER_PG_CONTAINER=umoya-postgres-master
DB_HOST=${SERVER_HOST}
DB_PORT=5432
DB_USERNAME=umoya
DB_PASSWORD=umoya_password
DB_DATABASE=umoya_master
