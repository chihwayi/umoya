# MediCore Mobile — Environment Variables
# Copy this file to .env and set the values below.
# Everything else (WebSocket URL, tenant discovery) is derived automatically.

# ── Required ──────────────────────────────────────────────────────────────────
# Tenant-service base URL — used ONLY for tenant discovery (pre-login).
# This resolves which EHR service URL to use for an authenticated tenant.
# Do NOT point this at the EHR service — it must point to the tenant-service.
EXPO_PUBLIC_API_BASE=http://localhost:3001

# ── Optional: Direct EHR override (dev only) ──────────────────────────────────
# Set this ONLY when bypassing tenant discovery in local development.
# In production leave blank — the EHR base URL is set after login
# from the tenant discovery response.
# EXPO_PUBLIC_EHR_BASE=http://localhost:3013

# ── Derived automatically (do NOT set manually) ────────────────────────────
# WS_BASE_URL      — derived from EXPO_PUBLIC_API_BASE (http→ws, https→wss)
# TENANT_URL       — derived as ${EXPO_PUBLIC_API_BASE}/api/tenants
# TENANT_API_URL   — derived as ${EXPO_PUBLIC_API_BASE}/api

# ── Daily.co / Telemedicine ────────────────────────────────────────────────
# Daily.co is a BACKEND concern only. The mobile app receives
# meeting URLs and signed tokens from the API — no Daily.co key
# is needed here. Backend keys are in services/ehr-service/.env:
#   DAILY_API_KEY=<your key>
#   DAILY_API_URL=https://api.daily.co/v1
#   DAILY_DOMAIN=<your-domain>.daily.co
