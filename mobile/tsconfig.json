{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "ignoreDeprecations": "6.0",
    "target": "ES2020",
    "moduleResolution": "bundler",
    "types": ["jest"],
    "baseUrl": ".",
    "paths": {
      "@design/*": [
        "src/design/*"
      ],
      "@ui/*": [
        "src/components/ui/*"
      ],
      "@doctor/*": [
        "src/components/doctor/*"
      ],
      "@nurse/*": [
        "src/components/nurse/*"
      ],
      "@patient/*": [
        "src/components/patient/*"
      ],
      "@shared/*": [
        "src/components/shared/*"
      ],
      "@navigation/*": [
        "src/navigation/*"
      ],
      "@services/*": [
        "src/services/*"
      ],
      "@stores/*": [
        "src/stores/*"
      ],
      "@hooks/*": [
        "src/hooks/*"
      ],
      "@utils/*": [
        "src/utils/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "e2e"
  ]
}
