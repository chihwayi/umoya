{
  "cli": {
    "version": ">= 7.0.0",
    "appVersionSource": "local",
    "requireCommit": true
  },
  "build": {
    "base": {
      "node": "22.14.0",
      "cache": {
        "key": "umoya-v1",
        "paths": ["node_modules", ".expo"]
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true,
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "apk",
        "resourceClass": "medium"
      },
      "channel": "development"
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium",
        "credentialsSource": "remote"
      },
      "android": {
        "buildType": "apk",
        "resourceClass": "medium",
        "credentialsSource": "remote"
      },
      "channel": "preview"
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "ios": {
        "resourceClass": "m-large",
        "credentialsSource": "remote",
        "image": "latest"
      },
      "android": {
        "buildType": "app-bundle",
        "resourceClass": "large",
        "credentialsSource": "remote",
        "image": "latest"
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId":     "REPLACE_WITH_APPLE_ID",
        "ascAppId":    "REPLACE_WITH_ASC_APP_ID",
        "appleTeamId": "REPLACE_WITH_TEAM_ID",
        "language":    "en-US",
        "sku":         "com.umoya.clinical"
      },
      "android": {
        "serviceAccountKeyPath": "./google-play-key.json",
        "track": "internal",
        "releaseStatus": "draft",
        "rollout": 0.1
      }
    }
  }
}
