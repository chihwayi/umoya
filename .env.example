
# URL Inheritance (set once; explicit *_URL values still override)
SERVICE_BASE_URL=
SERVICE_TENANT_PATH=/tenant-service
SERVICE_EHR_PATH=/ehr-service
SERVICE_CDSS_PATH=/cdss-service
REACT_APP_API_BASE_URL=
REACT_APP_TENANT_API_PATH=/tenant-service
REACT_APP_EHR_API_PATH=/ehr-service
REACT_APP_CDSS_API_PATH=/cdss-service

# Whisper Service
PORT_WHISPER=8001
USE_LOCAL_WHISPER=true
LOCAL_AI_BASE_URL=http://127.0.0.1:8080
LOCAL_WHISPER_PATH=/inference
LOCAL_OCR_PATH=/extract
LOCAL_WHISPER_URL=
LOCAL_OCR_URL=
FEATURE_POSTVISIT_ESCALATION_CONFIDENCE=false
FEATURE_POSTVISIT_DIARIZATION_REVIEW=false
POSTVISIT_DIARIZATION_MIN_CONFIDENCE=0.65
FEATURE_POSTVISIT_OCR_INTELLIGENCE=false
FEATURE_POSTVISIT_MEDICATION_INTELLIGENCE_V2=false
FEATURE_POSTVISIT_SPECIALTY_SOAP=false
FEATURE_POSTVISIT_MULTILINGUAL_TEACHBACK=false
FEATURE_POSTVISIT_INTRAVISIT_ALERTS=false
FEATURE_POSTVISIT_TRIAL_MATCHER=false
FEATURE_POSTVISIT_COMPANION_MEMORY=true
FEATURE_POSTVISIT_ADMIN_DOCS=false
FEATURE_POSTVISIT_VOICE_REVIEW=false
POSTVISIT_TRIAL_DECISION_SLA_HOURS=72
POSTVISIT_TRIAL_DECISION_ESCALATION_ROUTE=doctor
POSTVISIT_TRIAL_SLA_EMAIL_MIN_SEVERITY=high
POSTVISIT_TRIAL_SLA_SMS_MIN_SEVERITY=critical
POSTVISIT_TRIAL_SLA_NOTIFY_MAX_RECIPIENTS=3
POSTVISIT_CLINICALTRIALS_API_URL=https://clinicaltrials.gov/api/v2/studies

# Core database/auth
POSTGRES_DB=medicore
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_HOST=postgres-master
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
JWT_SECRET=dev_secret_key_change_in_production
SENTRY_DSN=

# Snowstorm/Elasticsearch
PORT_ELASTICSEARCH=9200
PORT_SNOWSTORM=8080

REACT_APP_TENANT_API_URL=/api
REACT_APP_BASE_DOMAIN=medicore.co.zw
REACT_APP_PROTOCOL=http
CDSS_ENABLE_AI=true
MOCK_VISION_AI=true
CDSS_REQUIRE_SERVICE_AUTH=true
CDSS_SERVICE_AUTH_MODE=both
CDSS_SERVICE_TOKEN=dev_cdss_service_token_change_in_production
CDSS_SERVICE_JWT_SECRET=dev_cdss_service_jwt_secret_change_in_production
CDSS_SERVICE_AUTH_ISSUER=medicore.ehr-service
CDSS_SERVICE_AUTH_AUDIENCE=medicore.cdss
CDSS_SERVICE_AUTH_JWT_REPLAY_STRICT=false
CDSS_OUTBOUND_TIMEOUT_MS=15000
CDSS_OUTBOUND_RETRY_MAX=2
CDSS_OUTBOUND_RETRY_BASE_MS=200
CDSS_CIRCUIT_BREAKER_FAIL_THRESHOLD=5
CDSS_CIRCUIT_BREAKER_OPEN_MS=30000
CDSS_PHI_REDACTION_ENABLED=true
CDSS_BLOCK_OUTBOUND_PHI=true
CDSS_STRICT_EGRESS_ALLOWLIST=true
CDSS_ENCRYPTION_ENABLED=true
CDSS_ENCRYPTION_PROVIDER=local
CDSS_ENCRYPTION_KEY_ID=local-dev-v1
CDSS_ENCRYPTION_KMS_KEY_ARN=
# Dev-only default key. Replace in production and rotate.
CDSS_ENCRYPTION_KEY=h7X7Tr_3k0-Tl3xw8tS9AqK3f7fjoGv0VGfT3d2i-9o=
# Optional JSON object for decrypt-only legacy keys during rotation.
# Example: {"local-dev-v0":"<fernet-key>"}
CDSS_ENCRYPTION_PREVIOUS_KEYS_JSON=
CDSS_ENCRYPTION_ALLOW_PLAINTEXT_READS=true
CDSS_JOB_WORKER_ENABLED=true
CDSS_JOB_QUEUE_NAME=cdss:jobs:queue
CDSS_JOB_DLQ_NAME=cdss:jobs:dead_letter
CDSS_JOB_WORKER_POLL_SECONDS=5
# Optional comma-separated hosts or URLs; defaults auto-include LLM_API_URL and EHR_SERVICE_URL.
CDSS_EGRESS_ALLOWLIST=
OWNER_EMAILS=owner@medicore.local
CDSS_OWNER_SCOPE_STRICT=false

# Frontend URLs for generated links / email templates
FRONTEND_URL=http://localhost:3000
PORTAL_BASE_URL=http://localhost:3000

LLM_API_URL=http://host.docker.internal:11434
LLM_MODEL_NAME=llama3.1:latest
WHISPER_API_KEY=your_openai_api_key_here
