# ══════════════════════════════════════════════════════════════════════════════
# MediCore — Environment Template  (commit this file, never .env)
#
# SETUP:
#   cp .env.example .env
#   # then edit .env — only SERVER_HOST and secrets need changing
#
# DEPLOYMENT (one command, all host-based URLs update automatically):
#   SERVER_HOST=192.168.1.50 envsubst < .env.example > .env
#
# Requires Docker Compose v2.24+ for ${VAR} expansion within .env files.
# ══════════════════════════════════════════════════════════════════════════════

# ── CHANGE THESE PER DEPLOYMENT ───────────────────────────────────────────────
SERVER_HOST=localhost
SYSTEM_DOMAIN=your-domain.com

# ── Core ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
ENVIRONMENT=development

# ── Database — single source of truth ─────────────────────────────────────────
POSTGRES_DB=medicore
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_in_production
SERVICE_POSTGRES_HOST=postgres-master
DB_PORT=5432
# Full DSN for scripts that run outside Docker
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${SERVER_HOST}:${DB_PORT}/${POSTGRES_DB}

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_in_production
OWNER_EMAILS=owner@your-domain.com
SENTRY_DSN=

# ── Service Ports ─────────────────────────────────────────────────────────────
PORT_POSTGRES=5432
PORT_REDIS=6379
PORT_MINIO=9000
PORT_MINIO_CONSOLE=9001
PORT_TENANT_SERVICE=3001
PORT_WEB_APP=3011
PORT_EHR_FRONTEND=3000
PORT_EHR_SERVICE=3013
PORT_CDSS_SERVICE=8000
PORT_WHISPER=8001
PORT_ELASTICSEARCH=9200
PORT_SNOWSTORM=8080

# ── Docker-internal service URLs (container → container — do not change) ──────
SERVICE_EHR_URL=http://ehr-service:3013
SERVICE_CDSS_URL=http://cdss-service:8000
SERVICE_REDIS_URL=redis://redis:6379
SERVICE_MINIO_URL=http://minio:9000

# ── Browser / client-facing URLs (all derive from SERVER_HOST) ────────────────
PUBLIC_EHR_BASE_URL=http://${SERVER_HOST}:${PORT_EHR_SERVICE}
FRONTEND_URL=http://${SERVER_HOST}:${PORT_EHR_FRONTEND}
PORTAL_BASE_URL=http://${SERVER_HOST}:3015
REACT_APP_API_URL=http://${SERVER_HOST}:${PORT_TENANT_SERVICE}/api
REACT_APP_EHR_API_URL=http://${SERVER_HOST}:${PORT_EHR_SERVICE}/api
REACT_APP_CDSS_API_URL=http://${SERVER_HOST}:${PORT_CDSS_SERVICE}
REACT_APP_WS_URL=ws://${SERVER_HOST}:${PORT_EHR_FRONTEND}
REACT_APP_BASE_DOMAIN=${SERVER_HOST}
REACT_APP_PROTOCOL=http
REACT_APP_CHOKIDAR_USEPOLLING=true

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://${SERVER_HOST}:${PORT_EHR_FRONTEND},http://${SERVER_HOST}:${PORT_WEB_APP},http://${SERVER_HOST}:3015

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://${SERVER_HOST}:${PORT_REDIS}
REDIS_HOST=redis

# ── MinIO / Object Storage — single source of truth ──────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_in_production
MINIO_PUBLIC_URL=http://${SERVER_HOST}:${PORT_MINIO}
BACKUP_BUCKET_NAME=backups
MINIO_BUCKET=medicore-dicom

# S3-compatible config — references MinIO credentials and endpoint above
AWS_REGION=us-east-1
STORAGE_S3_ENDPOINT=${SERVICE_MINIO_URL}
STORAGE_S3_BUCKET=medicore-documents
STORAGE_S3_ACCESS_KEY=${MINIO_ROOT_USER}
STORAGE_S3_SECRET_KEY=${MINIO_ROOT_PASSWORD}
STORAGE_S3_REGION=${AWS_REGION}
STORAGE_S3_FORCE_PATH_STYLE=true
STORAGE_S3_USE_SSL=false

# ── Local AI / Whisper ────────────────────────────────────────────────────────
USE_LOCAL_WHISPER=true
LOCAL_WHISPER_URL=http://${SERVER_HOST}:8080
LLM_API_URL=http://host.docker.internal:11434
LLM_MODEL_NAME=llama3.1:latest
WHISPER_API_KEY=your_whisper_api_key_here

# ── External APIs ─────────────────────────────────────────────────────────────
RXNORM_BASE_URL=https://rxnav.nlm.nih.gov/REST
OPENAI_API_KEY=your_openai_api_key_here
POSTVISIT_LLM_API_URL=https://api.openai.com/v1/chat/completions
POSTVISIT_LLM_MODEL=gpt-4o-mini
PAGERDUTY_EVENTS_API_URL=https://events.pagerduty.com/v2/enqueue
PAGERDUTY_ROUTING_KEY=your_pagerduty_routing_key_here

# ── DHIS2 ─────────────────────────────────────────────────────────────────────
DHIS2_URL=http://${SERVER_HOST}:8888
DHIS2_API_VERSION=40
DHIS2_PAT=your_dhis2_pat_here
DHIS2_USERNAME=
DHIS2_PASSWORD=
DHIS2_USE_MOCK=false
DHIS2_SCHEDULED_SYNC_ENABLED=false

# ── Daily.co — Telemedicine video ─────────────────────────────────────────────
DAILY_API_KEY=your_daily_co_api_key_here
DAILY_API_URL=https://api.daily.co/v1
DAILY_DOMAIN=your-subdomain.daily.co

# ── SMS Gateways ──────────────────────────────────────────────────────────────
SMS_GATEWAY_ECONET=https://api.econet.co.zw/sms
SMS_GATEWAY_TELECEL=https://api.telecel.co.zw/sms
SMS_GATEWAY_NETONE=https://api.netone.co.zw/sms

# ── CDSS ──────────────────────────────────────────────────────────────────────
CDSS_ENABLE_AI=true
MOCK_VISION_AI=true
CDSS_USE_EHR_TERMINOLOGY=true
CDSS_REQUIRE_SERVICE_AUTH=true
CDSS_SERVICE_TOKEN=change_in_production
CDSS_PHI_REDACTION_ENABLED=true
CDSS_BLOCK_OUTBOUND_PHI=true
CDSS_STRICT_EGRESS_ALLOWLIST=true
CDSS_EGRESS_ALLOWLIST=
CDSS_OWNER_SCOPE_STRICT=false
CDSS_SERVICE_AUTH_MODE=both
CDSS_SERVICE_JWT_SECRET=change_in_production
CDSS_SERVICE_AUTH_ISSUER=medicore.ehr-service
CDSS_SERVICE_AUTH_AUDIENCE=medicore.cdss
CDSS_SERVICE_AUTH_JWT_REPLAY_STRICT=false
CDSS_OUTBOUND_TIMEOUT_MS=15000
CDSS_OUTBOUND_RETRY_MAX=2
CDSS_OUTBOUND_RETRY_BASE_MS=200
CDSS_CIRCUIT_BREAKER_FAIL_THRESHOLD=5
CDSS_CIRCUIT_BREAKER_OPEN_MS=30000
CDSS_ENCRYPTION_ENABLED=true
CDSS_ENCRYPTION_PROVIDER=local
CDSS_ENCRYPTION_KEY_ID=local-dev-v1
CDSS_ENCRYPTION_KMS_KEY_ARN=
CDSS_ENCRYPTION_KEY=generate_with_openssl_rand_base64_32
CDSS_ENCRYPTION_PREVIOUS_KEYS_JSON=
CDSS_ENCRYPTION_ALLOW_PLAINTEXT_READS=true
CDSS_JOB_WORKER_ENABLED=true
CDSS_JOB_QUEUE_NAME=cdss:jobs:queue
CDSS_JOB_DLQ_NAME=cdss:jobs:dead_letter
CDSS_JOB_WORKER_POLL_SECONDS=5

# ── PHI Encryption + Feedback Persistence (Sprint 112) ───────────────────────
# FEEDBACK_PG_DSN uses master DB credentials defined above
FEEDBACK_PG_DSN=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${SERVICE_POSTGRES_HOST}:${DB_PORT}/${POSTGRES_DB}
ENCRYPTION_KEY=<run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))">

# ── Clinical RAG (Sprint 114) ─────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Denial Prediction (Sprint 115) ───────────────────────────────────────────
DENIAL_MODEL_PATH=/models/denial_prediction.pkl

# ── PostVisit Feature Flags ───────────────────────────────────────────────────
FEATURE_POSTVISIT_ESCALATION_CONFIDENCE=false
FEATURE_POSTVISIT_DIARIZATION_REVIEW=false
POSTVISIT_DIARIZATION_MIN_CONFIDENCE=0.65
FEATURE_POSTVISIT_OCR_INTELLIGENCE=false
FEATURE_POSTVISIT_MEDICATION_INTELLIGENCE_V2=false
FEATURE_POSTVISIT_SPECIALTY_SOAP=false
FEATURE_POSTVISIT_MULTILINGUAL_TEACHBACK=false
FEATURE_POSTVISIT_INTRAVISIT_ALERTS=false
FEATURE_POSTVISIT_TRIAL_MATCHER=false
FEATURE_POSTVISIT_COMPANION_MEMORY=true
FEATURE_POSTVISIT_ADMIN_DOCS=false
FEATURE_POSTVISIT_VOICE_REVIEW=false
POSTVISIT_TRIAL_DECISION_SLA_HOURS=72
POSTVISIT_TRIAL_DECISION_ESCALATION_ROUTE=doctor
POSTVISIT_TRIAL_SLA_EMAIL_MIN_SEVERITY=high
POSTVISIT_TRIAL_SLA_SMS_MIN_SEVERITY=critical
POSTVISIT_TRIAL_SLA_NOTIFY_MAX_RECIPIENTS=3
POSTVISIT_CLINICALTRIALS_API_URL=https://clinicaltrials.gov/api/v2/studies
POSTVISIT_CLINICALTRIALS_STUDY_BASE_URL=https://clinicaltrials.gov/study
