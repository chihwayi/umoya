# MediCore environment template
#
# Deployment model:
# 1. Preferred for deployed environments: set the three base values below once.
# 2. Local multi-port development can keep the explicit *_URL overrides below.

NODE_ENV=development
SYSTEM_DOMAIN=medicore.co.zw

# Single-base URL inheritance for deployed environments
SERVICE_BASE_URL=
SERVICE_TENANT_PATH=/tenant-service
SERVICE_EHR_PATH=/ehr-service
SERVICE_CDSS_PATH=/cdss-service

REACT_APP_API_BASE_URL=
REACT_APP_TENANT_API_PATH=/tenant-service/api
REACT_APP_EHR_API_PATH=/ehr-service/api
REACT_APP_CDSS_API_PATH=/cdss-service

PUBLIC_APP_BASE_URL=
PUBLIC_STAFF_APP_PATH=/
PUBLIC_PATIENT_PORTAL_PATH=/patient
PUBLIC_ADMIN_APP_PATH=/admin

# Explicit service URLs for local docker or split-host deployments
SERVICE_TENANT_URL=http://tenant-service:3001
SERVICE_EHR_URL=http://ehr-service:3013
SERVICE_CDSS_URL=http://cdss-service:8000
SUPER_ADMIN_TEST_TENANT_ID=kids-clinic
DOCKER_SOCKET_PATH=/var/run/docker.sock

# Explicit browser-facing URLs for local multi-port development
REACT_APP_TENANT_API_URL=http://localhost:3001/api
REACT_APP_EHR_API_URL=http://localhost:3013/api
REACT_APP_CDSS_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
PORTAL_BASE_URL=http://localhost:3015
WEB_APP_URL=http://localhost:3011
REACT_APP_BASE_DOMAIN=medicore.co.zw
REACT_APP_PROTOCOL=http

# Core database/auth
POSTGRES_DB=medicore
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_HOST=postgres-master
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgresql://medicore:medicore_password@localhost:5432/medicore_master
JWT_SECRET=dev_secret_key_change_in_production
SENTRY_DSN=

# Local service URLs used by helper scripts
ELASTICSEARCH_URL=http://localhost:9200
SNOWSTORM_URL=http://localhost:8080
WHISPER_SERVICE_URL=http://localhost:8001
GRAFANA_URL=http://localhost:3012

# Service Ports
PORT_POSTGRES=5432
PORT_REDIS=6379
PORT_MINIO=9000
PORT_MINIO_CONSOLE=9001
PORT_TENANT_SERVICE=3001
PORT_WEB_APP=3011
PORT_GRAFANA=3012
PORT_EHR_SERVICE=3013
PORT_PATIENT_PORTAL=3015
PORT_MEDICAL_AID_DEMO_SERVICE=3004
PORT_WHISPER=8001
PORT_CDSS_SERVICE=8000
PORT_SNOWSTORM=8080
PORT_ELASTICSEARCH=9200

# Demo Medical Aid Provider Integration
MEDICAL_AID_DEMO_ENABLED=true
MEDICAL_AID_DEMO_FORCE=false
MEDICAL_AID_DEMO_BASE_URL=http://medical-aid-demo-service:3004
MEDICAL_AID_DEMO_API_KEY=demo-medical-aid-key
MEDICAL_AID_DEMO_PROVIDER_NAMES=cimas,premier,econet_health,psmas,first_mutual,demo_aid
MEDICAL_AID_DEMO_PROVIDER_NAME=MediCore Demo Medical Aid
MEDICAL_AID_DEMO_PROVIDER_CODE=demo_aid
MEDICAL_AID_DEMO_REQUIRE_API_KEY=false

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3011,http://localhost:3015

# AI, LLM, and document intelligence
USE_LOCAL_WHISPER=true
LOCAL_AI_BASE_URL=http://127.0.0.1:8080
LOCAL_WHISPER_PATH=/inference
LOCAL_OCR_PATH=/extract
LOCAL_WHISPER_URL=
LOCAL_OCR_URL=
WHISPER_API_URL=https://api.openai.com/v1/audio/transcriptions
WHISPER_API_KEY=your_openai_api_key_here
OPENAI_API_KEY=
LLM_API_URL=http://host.docker.internal:11434
LLM_MODEL_NAME=llama3.1:latest
POSTVISIT_LLM_API_URL=https://api.openai.com/v1/chat/completions
POSTVISIT_LLM_MODEL=gpt-4o-mini
PAGERDUTY_EVENTS_API_URL=https://events.pagerduty.com/v2/enqueue
RXNORM_BASE_URL=https://rxnav.nlm.nih.gov/REST
POSTVISIT_CLINICALTRIALS_API_URL=https://clinicaltrials.gov/api/v2/studies
POSTVISIT_CLINICALTRIALS_STUDY_BASE_URL=https://clinicaltrials.gov/study

FEATURE_POSTVISIT_ESCALATION_CONFIDENCE=false
FEATURE_POSTVISIT_DIARIZATION_REVIEW=false
POSTVISIT_DIARIZATION_MIN_CONFIDENCE=0.65
FEATURE_POSTVISIT_OCR_INTELLIGENCE=false
FEATURE_POSTVISIT_MEDICATION_INTELLIGENCE_V2=false
FEATURE_POSTVISIT_SPECIALTY_SOAP=false
FEATURE_POSTVISIT_MULTILINGUAL_TEACHBACK=false
FEATURE_POSTVISIT_INTRAVISIT_ALERTS=false
FEATURE_POSTVISIT_TRIAL_MATCHER=false
FEATURE_POSTVISIT_COMPANION_MEMORY=true
FEATURE_POSTVISIT_ADMIN_DOCS=false
FEATURE_POSTVISIT_VOICE_REVIEW=false
POSTVISIT_TRIAL_DECISION_SLA_HOURS=72
POSTVISIT_TRIAL_DECISION_ESCALATION_ROUTE=doctor
POSTVISIT_TRIAL_SLA_EMAIL_MIN_SEVERITY=high
POSTVISIT_TRIAL_SLA_SMS_MIN_SEVERITY=critical
POSTVISIT_TRIAL_SLA_NOTIFY_MAX_RECIPIENTS=3

# CDSS security and ops
CDSS_ENABLE_AI=true
MOCK_VISION_AI=true
CDSS_REQUIRE_SERVICE_AUTH=true
CDSS_SERVICE_AUTH_MODE=both
CDSS_SERVICE_TOKEN=dev_cdss_service_token_change_in_production
CDSS_SERVICE_JWT_SECRET=dev_cdss_service_jwt_secret_change_in_production
CDSS_SERVICE_AUTH_ISSUER=medicore.ehr-service
CDSS_SERVICE_AUTH_AUDIENCE=medicore.cdss
CDSS_SERVICE_AUTH_JWT_REPLAY_STRICT=false
CDSS_OUTBOUND_TIMEOUT_MS=15000
CDSS_OUTBOUND_RETRY_MAX=2
CDSS_OUTBOUND_RETRY_BASE_MS=200
CDSS_CIRCUIT_BREAKER_FAIL_THRESHOLD=5
CDSS_CIRCUIT_BREAKER_OPEN_MS=30000
CDSS_PHI_REDACTION_ENABLED=true
CDSS_BLOCK_OUTBOUND_PHI=true
CDSS_STRICT_EGRESS_ALLOWLIST=true
CDSS_ENCRYPTION_ENABLED=true
CDSS_ENCRYPTION_PROVIDER=local
CDSS_ENCRYPTION_KEY_ID=local-dev-v1
CDSS_ENCRYPTION_KMS_KEY_ARN=
CDSS_ENCRYPTION_KEY=h7X7Tr_3k0-Tl3xw8tS9AqK3f7fjoGv0VGfT3d2i-9o=
CDSS_ENCRYPTION_PREVIOUS_KEYS_JSON=
CDSS_ENCRYPTION_ALLOW_PLAINTEXT_READS=true
CDSS_JOB_WORKER_ENABLED=true
CDSS_JOB_QUEUE_NAME=cdss:jobs:queue
CDSS_JOB_DLQ_NAME=cdss:jobs:dead_letter
CDSS_JOB_WORKER_POLL_SECONDS=5
CDSS_EGRESS_ALLOWLIST=
OWNER_EMAILS=owner@medicore.local
CDSS_OWNER_SCOPE_STRICT=false

# DHIS2 integration
DHIS2_URL=https://dhis2.example.org
DHIS2_API_VERSION=40
DHIS2_PAT=
DHIS2_USERNAME=
DHIS2_PASSWORD=
DHIS2_ORG_UNIT=
DHIS2_TRACKED_ENTITY_TYPE=
DHIS2_DATASET_ID=
DHIS2_USE_MOCK=false
DHIS2_SCHEDULED_SYNC_ENABLED=false
DHIS2_SCHEDULED_RETRY_LIMIT=20
DHIS2_ALERT_LOOKBACK_HOURS=24
DHIS2_ALERT_ERROR_THRESHOLD=10
DHIS2_ALERT_WEBHOOK_URL=
DHIS2_PAGERDUTY_ROUTING_KEY=

# Storage / object URLs
MINIO_PUBLIC_URL=http://localhost:9000

# Notifications
SMS_GATEWAY_ECONET=https://api.econet.co.zw/sms
SMS_GATEWAY_TELECEL=https://api.telecel.co.zw/sms
SMS_GATEWAY_NETONE=https://api.netone.co.zw/sms

# Local infrastructure
REDIS_URL=redis://localhost:6379
