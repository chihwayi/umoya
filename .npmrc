# Prevent React and React Native from being hoisted to root
# This ensures mobile-app uses its own React instance
# Use nohoist for npm workspaces (older syntax that works better)
public-hoist-pattern[]=*
public-hoist-pattern[]=!react
public-hoist-pattern[]=!react/**
public-hoist-pattern[]=!react-native
public-hoist-pattern[]=!react-native/**
public-hoist-pattern[]=!@react-native/*
public-hoist-pattern[]=!@react-native/**
public-hoist-pattern[]=!react-redux
public-hoist-pattern[]=!react-redux/**
public-hoist-pattern[]=!@reduxjs/*
public-hoist-pattern[]=!@reduxjs/**


