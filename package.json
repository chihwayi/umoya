{
  "name": "medicore",
  "version": "1.0.0",
  "description": "Multi-tenant eHR system for private clinics in Zimbabwe",
  "main": "index.js",
  "scripts": {
    "dev": "docker-compose up -d",
    "build": "npm run build:services && npm run build:web",
    "build:services": "lerna run build",
    "build:web": "cd web-app && npm run build",
    "test": "lerna run test",
    "test:e2e": "cd tests/e2e && npm test",
    "lint": "lerna run lint",
    "setup": "./scripts/setup.sh",
    "migrate": "./scripts/migrate.sh",
    "deploy": "./scripts/deploy.sh",
    "backup": "./scripts/backup.sh"
  },
  "workspaces": [
    "services/*",
    "web-app",
    "mobile-app"
  ],
  "devDependencies": {
    "lerna": "^7.4.2",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.45.0",
    "prettier": "^3.0.0",
    "husky": "^8.0.3",
    "lint-staged": "^13.2.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/medicore/medicore.git"
  },
  "keywords": [
    "ehr",
    "healthcare",
    "zimbabwe",
    "multi-tenant",
    "medical-aid",
    "fhir",
    "hl7",
    "cdss",
    "ai"
  ],
  "author": "MediCore Solutions",
  "license": "PROPRIETARY",
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}