@baseUrl = http://localhost:3001
@tenant_id = {{create_tenant.response.body.id}}

### Test Tenant Service Endpoints

### 1. Create a new tenant
# @name create_tenant
POST {{baseUrl}}/tenants
Content-Type: application/json

{
  "clinicName": "Dr. Smith Family Clinic",
  "subdomain": "dr-smith-clinic",
  "contactEmail": "admin@drsmithclinic.co.zw",
  "contactPhone": "+263771234567",
  "address": "123 Medical Drive, Harare",
  "city": "Harare",
  "subscriptionTier": "professional"
}

### 2. Get all tenants
GET {{baseUrl}}/tenants

### 3. Get tenant by ID
GET {{baseUrl}}/tenants/{{tenant_id}}

### 4. Get tenant by subdomain
GET {{baseUrl}}/tenants/subdomain/dr-smith-clinic

### 5. Update tenant status
PUT {{baseUrl}}/tenants/{{tenant_id}}/status
Content-Type: application/json

{
  "status": "active"
}

### 6. Check tenant health
GET {{baseUrl}}/tenants/{{tenant_id}}/health

### 7. Delete tenant (use with caution)
DELETE {{baseUrl}}/tenants/{{tenant_id}}

### Test with different subscription tiers

### Basic tier tenant
POST {{baseUrl}}/tenants
Content-Type: application/json

{
  "clinicName": "Community Health Center",
  "subdomain": "community-health",
  "contactEmail": "admin@community-health.co.zw",
  "contactPhone": "+263772345678",
  "address": "456 Community Road, Bulawayo",
  "city": "Bulawayo",
  "subscriptionTier": "basic"
}
